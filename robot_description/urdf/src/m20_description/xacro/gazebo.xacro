<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find robot_common)/xacro/gazebo_plugins.xacro"/>

    <xacro:property name="leg_torque_max" value="76.4"/>
    <xacro:property name="wheel_torque_max" value="21.6"/>

    <!-- ──────────────────────── Gazebo plugins ──────────────────────────── -->
    <!-- imu -->
    <xacro:gazebo_imu_sensor reference="imu_link"/>

    <!-- pose -->
    <xacro:gazebo_p3d body_name="base"/>

    <!-- Show the trajectory of trunk center. -->
    <xacro:gazebo_link_plot_3d link="base" material="Gazebo/Yellow"/>

    <!-- ──────────────────────── ros2_control ──────────────────────────── -->
  
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>

        <xacro:macro name="joint_interface" params="joint_name torque_limit">
            <joint name="${joint_name}">
                <command_interface name="effort">
                    <param name="min">-${torque_limit}</param>
                    <param name="max">${torque_limit}</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
        </xacro:macro>

        <xacro:macro name="leg_joints" params="prefix">
            <xacro:joint_interface joint_name="${prefix}_hipx_joint" torque_limit="${leg_torque_max}"/>
            <xacro:joint_interface joint_name="${prefix}_hipy_joint" torque_limit="${leg_torque_max}"/>
            <xacro:joint_interface joint_name="${prefix}_knee_joint" torque_limit="${leg_torque_max}"/>
            <xacro:joint_interface joint_name="${prefix}_wheel_joint" torque_limit="${wheel_torque_max}"/>
        </xacro:macro>

        <xacro:leg_joints prefix="fl"/>
        <xacro:leg_joints prefix="fr"/>
        <xacro:leg_joints prefix="hl"/>
        <xacro:leg_joints prefix="hr"/>
    </ros2_control>

    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>$(find m20_description)/config/m20_control_ros2.yaml</parameters>
        </plugin>
    </gazebo>

    <gazebo reference="base_link">
        <material>Gazebo/Grey</material>
        <turnGravityOff>false</turnGravityOff>
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <kp>1000000.0</kp>
        <kd>1.0</kd>
    </gazebo>

    <gazebo reference="imu_link">
        <material>Gazebo/Red</material>
    </gazebo>

    <xacro:macro name="leg_gazebo" params="prefix">
        <gazebo reference="${prefix}_hipx">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
        </gazebo>
        <gazebo reference="${prefix}_hipy">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <self_collide>true</self_collide>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
        </gazebo>
        <gazebo reference="${prefix}_knee">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <self_collide>true</self_collide>
        </gazebo>
        <gazebo reference="${prefix}_wheel">
            <mu1>0.6</mu1>
            <mu2>0.6</mu2>
            <self_collide>true</self_collide>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
        </gazebo>
    </xacro:macro>

    <xacro:leg_gazebo prefix="fr"/>
    <xacro:leg_gazebo prefix="fl"/>
    <xacro:leg_gazebo prefix="hr"/>
    <xacro:leg_gazebo prefix="hl"/>

</robot>
